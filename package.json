{
  "name": "esbuild-plugin-json-cleaner",
  "version": "0.2.0",
  "description": "esbuild plugin to cleanup JSON files",
  "keywords": [
    "esbuild",
    "json",
    "plugin"
  ],
  "homepage": "https://github.com/AFCMS/esbuild-plugin-json-cleaner",
  "bugs": {
    "url": "https://github.com/AFCMS/esbuild-plugin-json-cleaner/issues"
  },
  "license": "MIT",
  "author": {
    "name": "AFCMS",
    "email": "afcm.contact@gmail.com",
    "url": "https://afcms.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AFCMS/esbuild-plugin-json-cleaner.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": "./dist/index.mjs",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "release": "bumpp",
    "prepublishOnly": "pnpm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@types/node": "^24.19.1",
    "bumpp": "^12.3.0",
    "esbuild": "^0.28.2",
    "oxfmt": "^0.71.0",
    "oxlint": "^1.86.0",
    "oxlint-tsgolint": "^7.0.2003",
    "publint": "^0.3.25",
    "tsdown": "^0.23.0",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "esbuild": "^0.28.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12",
      "onFail": "error"
    },
    "runtime": {
      "name": "node",
      "version": "^24",
      "onFail": "error"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.9.1"
}
